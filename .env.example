# 先用阿里云百炼华北2（北京）地域；只在本地 .env 中填写真实值。
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_WORKSPACE_ID=
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.8
API_TIMEOUT=90
TTS_CHUNK_SIZE=800

# 文本使用其他 OpenAI 兼容服务时，取消注释并填写这两项：
# LLM_API_KEY=
# LLM_BASE_URL=https://your-provider.example/v1

# 普通播放和当前 Data URI 克隆不需要 OSS，以下仅供扩展适配：
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
